{
  "name": "@hagicode/hagi-release-drafter",
  "version": "0.1.0",
  "description": "Composite GitHub Action that drafts the next stable vX.Y.Z release from Conventional Commits. Never publishes.",
  "type": "module",
  "bin": {
    "hagi-release-drafter": "dist/cli.js"
  },
  "files": [
    "action.yml",
    "dist/",
    "scripts/",
    "!scripts/npm-release.ts",
    "README*.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@octokit/rest": "22.0.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/hagi-release-drafter.git"
  },
  "bugs": {
    "url": "https://github.com/HagiCode-org/hagi-release-drafter/issues"
  },
  "homepage": "https://github.com/HagiCode-org/hagi-release-drafter#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
